[
  {
    "name": "origin-http-default",
    "input": {
      "url": "/",
      "ssl": false,
      "method": "GET",
      "headers": {
        "host": "example.test"
      }
    },
    "expected": {
      "protocol": "http:",
      "hostname": "example.test",
      "port": 80,
      "path": "/",
      "headers": {
        "host": "example.test",
        "connection": "keep-alive"
      }
    }
  },
