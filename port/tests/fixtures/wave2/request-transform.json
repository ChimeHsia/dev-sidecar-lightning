        ],
        "x-multi": [
          "first",
          "second"
        ]
      }
    },
    "expected": {
      "protocol": "https:",
      "hostname": "example.test",
      "port": 443,
      "path": "/close",
      "headers": {
        "host": "example.test",
        "connection": [
          "Upgrade",
          " Keep-Alive, CLOSE "
        ],
        "x-multi": [
          "first",
          "second"
        ]
      }
    }
  },
