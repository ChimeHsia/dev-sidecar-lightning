        "content-length": "0"
      }
    },
    "expected": {
      "protocol": "http:",
      "hostname": "route.test",
      "port": 80,
      "path": "/path",
      "headers": {
        "host": "route.test",
        "authorization": "Bearer retained",
        "proxy-authorization": "Basic retained",
        "x-multi": [
          "a",
          "b"
        ],
        "content-length": "0",
        "connection": "keep-alive"
      }
    }
