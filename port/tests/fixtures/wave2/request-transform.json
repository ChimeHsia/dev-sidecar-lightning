  {
    "name": "http2-pseudo-and-proxy-connection-filter",
    "input": {
      "url": "/h2",
      "ssl": true,
      "method": "POST",
      "headers": {
        "host": "example.test",
        ":method": "POST",
        ":path": "/ignored",
        ":authority": "ignored.test",
        ":scheme": "http",
        "proxy-connection": "close",
        "x-present": "yes"
      }
    },
    "expected": {
      "protocol": "https:",
      "hostname": "example.test",
      "port": 443,
      "path": "/h2",
      "headers": {
        "host": "example.test",
        "x-present": "yes",
        "connection": "keep-alive"
      }
    }
  },
  {
    "name": "authorization-and-other-headers-survive",
    "input": {
      "url": "http://other.test/path",
