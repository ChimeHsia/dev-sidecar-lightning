  {
    "name": "mapping with family and usa alias",
    "input": {
      "operation": "select",
      "providers": {
        "cloudflare": {
          "server": "1.1.1.1",
          "family": 6
        }
      },
      "mapping": {
        "*.example.com": {
          "dnsName": "usa",
          "family": 4
        }
      },
      "hostname": "www.example.com"
    },
    "expected": {
      "choice": {
        "providerKey": "provider:cloudflare",
        "family": 4
      },
      "isNat64": false,
      "isEch": false,
      "ignorePreSet": true,
      "echProviderKey": null
    }
  },
  {
    "name": "unknown mapped provider",
    "input": {
      "operation": "select",
      "mapping": {
        "*": {
          "dnsName": "unknown",
          "family": 6
        }
      },
      "hostname": "x.example"
    },
    "expected": {
      "choice": null,
      "isNat64": false,
      "isEch": false,
      "ignorePreSet": true,
      "echProviderKey": null
    }
  },
  {
    "name": "empty mapping",
    "input": {
      "operation": "select",
      "hostname": "x.example"
    },
    "expected": {
      "choice": null,
      "isNat64": false,
      "isEch": false,
      "ignorePreSet": true,
      "echProviderKey": null
    }
  },
  {
    "name": "preset takes precedence",
    "input": {
      "operation": "select",
      "providers": {
        "cloudflare": {
          "server": "1.1.1.1"
        }
      },
      "preSetIpList": {
        "*.example.com": []
      },
      "mapping": {
        "*": {
          "dnsName": "cloudflare",
          "family": 6
        }
      },
      "hostname": "example.com"
    },
    "expected": {
      "choice": {
        "providerKey": "builtin:PreSet",
        "family": null
      },
      "isNat64": false,
      "isEch": false,
      "ignorePreSet": true,
      "echProviderKey": null
    }
  },
  {
    "name": "ech replaces preset",
    "input": {
      "operation": "select",
      "providers": {
        "doh": {
          "server": "https://doh.test/query"
        }
      },
      "preSetIpList": {
        "*": {
          "ip": "1.2.3.4"
        }
      },
      "ech": {
        "domains": [
          "*.example.com"
        ],
        "dns": "doh"
      },
      "mapping": {
        "*": {
          "dnsName": "doh",
          "family": 6
        }
      },
      "hostname": "foo.example.com"
    },
    "expected": {
      "choice": {
        "providerKey": "provider:doh",
        "family": null
      },
      "isNat64": false,
      "isEch": true,
      "ignorePreSet": true,
      "echProviderKey": "provider:doh"
    }
  },
  {
    "name": "ech preset exception",
    "input": {
      "operation": "select",
      "providers": {
        "doh": {
          "server": "https://doh.test/query"
        }
      },
      "preSetIpList": {
        "*": [
          "1.2.3.4"
        ]
      },
      "ech": {
        "domains": [
          "*.example.com"
        ],
        "preSetIpDomains": {
          "foo.example.com": true
        },
        "dns": "doh"
      },
      "hostname": "foo.example.com"
    },
    "expected": {
      "choice": {
        "providerKey": "builtin:PreSet",
        "family": null
      },
      "isNat64": false,
      "isEch": true,
      "ignorePreSet": false,
      "echProviderKey": "provider:doh"
    }
  },
  {
    "name": "nat64 wins ech and preset",
    "input": {
      "operation": "select",
      "providers": {
        "doh": {
          "server": "https://doh.test/query"
        }
      },
      "options": {
        "nat64": {
          "enabled": true
        }
      },
      "nat64Domains": [
        "*.example.com"
      ],
      "preSetIpList": {
        "*": [
          "1.2.3.4"
        ]
      },
      "ech": {
        "enabled": false,
        "dns": "doh"
      },
      "hostname": "foo.example.com"
    },
    "expected": {
      "choice": {
        "providerKey": "builtin:Nat64",
        "family": null
      },
      "isNat64": true,
      "isEch": true,
      "ignorePreSet": true,
      "echProviderKey": "provider:doh"
    }
  },
  {
    "name": "missing ech provider falls back to mapping",
    "input": {
      "operation": "select",
      "providers": {
        "local": {
          "server": "127.0.0.1"
        }
      },
      "ech": {
        "domains": {
          "example.com": 0
        },
        "dns": "missing"
      },
      "mapping": {
        "example.com": {
          "dnsName": "local",
          "family": "6"
        }
      },
      "hostname": "example.com"
    },
    "expected": {
      "choice": {
        "providerKey": "provider:local",
        "family": "6"
      },
      "isNat64": false,
      "isEch": true,
      "ignorePreSet": true,
      "echProviderKey": null
    }
  },
  {
    "name": "ech disabled uses preset",
