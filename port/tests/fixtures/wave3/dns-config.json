  {
    "name": "doh csv",
    "input": {
      "operation": "toDohList",
      "doh": " a, ,b,a,  c "
    },
    "expected": [
      "a",
      "b",
      "a",
      "c"
    ]
  },
  {
    "name": "doh array keeps commas",
    "input": {
      "operation": "toDohList",
      "doh": [
        " a,b ",
        " ",
        "https://one",
        "https://one"
      ]
    },
    "expected": [
      "a,b",
      "https://one",
      "https://one"
    ]
  },
  {
    "name": "doh null",
