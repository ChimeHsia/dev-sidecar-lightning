    },
    "expected": []
  },
  {
    "name": "selected doh first and duplicate keeps sni",
    "input": {
      "operation": "resolveDohList",
      "config": {
        "dns": " main ",
        "doh": [
          "https://dns.alidns.com/resolve",
          "https://extra/query",
          "https://extra/query"
        ]
      },
      "providers": {
        "main": {
          "server": " dns.alidns.com/resolve ",
          "type": " d o h ",
          "servername": "front"
        }
      }
    },
    "expected": [
      {
        "url": "dns.alidns.com/resolve",
        "sni": "front"
      },
      {
        "url": "https://dns.alidns.com/resolve",
        "sni": ""
      },
      {
        "url": "https://extra/query",
        "sni": ""
      },
      {
        "url": "https://cloudflare-dns.com/dns-query",
        "sni": ""
      },
      {
        "url": "https://dns.google/resolve",
        "sni": ""
      }
    ]
  },
